# Copy to .env and fill in. NEVER commit .env
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# --- AI (Google AI Studio key) ---
GEMINI_API_KEY=
# Use the exact Gemma 4 / Gemini model id from AI Studio
GEMINI_MODEL=gemini-2.5-flash

# --- DevDraft (production keys issued at kickoff) ---
DEVDRAFT_BASE_URL=https://api.devdraft.ai/api/v0
DEVDRAFT_CLIENT_KEY=
DEVDRAFT_CLIENT_SECRET=
DEVDRAFT_CURRENCY=usdc
DEVDRAFT_LINK_TYPE=PRODUCT
DEVDRAFT_RECURRING_TYPE=ONE_TIME
# Webhook signing secret from DevDraft dashboard
DEVDRAFT_WEBHOOK_SECRET=
DEVDRAFT_SIGNATURE_HEADER=x-devdraft-signature

# --- Hackathon safety limits (USD) ---
MAX_TX_USD=5
MAX_TOTAL_USD=50

# --- WhatsApp (whatsapp-web.js) ---
ENABLE_WHATSAPP=false
# Owner's own number, digits only incl. country code, e.g. 260971234567
OWNER_WHATSAPP=
BUSINESS_NAME=SnapSell Demo Shop

# --- Dashboard password (Basic auth on /admin.html and /api/admin/*). Set it! ---
ADMIN_PASSWORD=
