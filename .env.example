# SnapSell configuration. Copy to .env (or run `pnpm setup`, which also generates the secrets).
# Never commit .env.

NODE_ENV=development

# --- Web / API -------------------------------------------------------------
# Public URL customers and the owner use. HTTPS here turns on Secure cookies.
# `pnpm demo` does not change this. It publishes POST /api/webhooks/devdraft for DevDraft.
PUBLIC_WEB_URL=http://localhost:3000
# Where the Next.js app reaches the API (server side).
API_INTERNAL_URL=http://127.0.0.1:4000
PORT=4000
LOG_LEVEL=info

# --- Storage ----------------------------------------------------------------
# Database, uploads, logs and backups live here. Defaults to ./data in the repo.
# DATA_DIR=/data
MAX_UPLOAD_MB=15

# --- Secrets (at least 32 random characters each) -----------------------------
SESSION_SECRET=
FILE_SIGNING_SECRET=

# --- Owner account (used once, on first start) ---------------------------------
OWNER_EMAIL=
OWNER_NAME=Shop owner
# Remove after the first start. Forgot it? `pnpm reset-owner-password`.
OWNER_INITIAL_PASSWORD=

# --- Email (Resend) -----------------------------------------------------------
# Leave empty in development: emails are written to data/logs/emails instead.
RESEND_API_KEY=
EMAIL_FROM=SnapSell <onboarding@resend.dev>

# --- AI (Google Gemini) ---------------------------------------------------------
# Powers "Snap to sell" now and the WhatsApp assistant later. Get a key at aistudio.google.com.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Payments (DevDraft) ---------------------------------------------------------
# fake = simulated payments on a local test page (development only); sandbox or live = real DevDraft.
DEVDRAFT_MODE=fake
# DEVDRAFT_BASE_URL=https://api.devdraft.com
# DEVDRAFT_CLIENT_KEY=
# DEVDRAFT_CLIENT_SECRET=
# Signing secret of the webhook registered in DevDraft for https://<your-domain>/api/webhooks/devdraft
# DEVDRAFT_WEBHOOK_SECRET=
# DEVDRAFT_LINK_TYPE=INVOICE
# Currencies your DevDraft account accepts (docs list usdc, eurc). ZMW orders are refused until confirmed.
# DEVDRAFT_CURRENCIES=usdc,eurc
# The customer payment URL isn't in DevDraft's published docs. Set ONE of these once they confirm it:
# DEVDRAFT_PAYMENT_URL_FIELD=paymentUrl
# DEVDRAFT_PAYMENT_URL_TEMPLATE=https://pay.devdraft.com/{url}

# --- WhatsApp service (apps/whatsapp) -------------------------------------------
# Signs calls between the API and the WhatsApp service. Required in production;
# in development it is derived from SESSION_SECRET when empty.
INTERNAL_HMAC_SECRET=
# Where the API reaches the WhatsApp service (localhost / private network only).
WHATSAPP_SERVICE_URL=http://127.0.0.1:4100
# Where the WhatsApp service reaches the API.
# API_URL=http://127.0.0.1:4000