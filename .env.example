# SnapSell configuration. Copy to .env (or run `pnpm setup`, which also generates the secrets).
# Never commit .env.

NODE_ENV=development

# --- Web / API -------------------------------------------------------------
# Public URL customers and the owner use. HTTPS here turns on Secure cookies.
PUBLIC_WEB_URL=http://localhost:3000
# Where the Next.js app reaches the API (server side).
API_INTERNAL_URL=http://127.0.0.1:4000
PORT=4000
LOG_LEVEL=info

# --- Storage ----------------------------------------------------------------
# Database, uploads, logs and backups live here. Defaults to ./data in the repo.
# DATA_DIR=/data
MAX_UPLOAD_MB=15

# --- Secrets (at least 32 random characters each) -----------------------------
SESSION_SECRET=
FILE_SIGNING_SECRET=

# --- Owner account (used once, on first start) ---------------------------------
OWNER_EMAIL=
OWNER_NAME=Shop owner
# Remove after the first start. Forgot it? `pnpm reset-owner-password`.
OWNER_INITIAL_PASSWORD=

# --- Email (Resend) -----------------------------------------------------------
# Leave empty in development: emails are written to data/logs/emails instead.
RESEND_API_KEY=
EMAIL_FROM=SnapSell <onboarding@resend.dev>

# --- AI (Google Gemini) ---------------------------------------------------------
# Powers "Snap to sell" now and the WhatsApp assistant later. Get a key at aistudio.google.com.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Later phases ---------------------------------------------------------------
# DEVDRAFT_BASE_URL=
# DEVDRAFT_CLIENT_KEY=
# DEVDRAFT_CLIENT_SECRET=
# DEVDRAFT_WEBHOOK_SECRET=
# INTERNAL_HMAC_SECRET=
