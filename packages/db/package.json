{
  "name": "@snapsell/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema": { "types": "./dist/schema.d.ts", "default": "./dist/schema.js" }
  },
  "files": ["dist", "drizzle"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "pnpm build && node dist/migrate-cli.js",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@snapsell/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@snapsell/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "vitest": "^4.0.0"
  }
}
