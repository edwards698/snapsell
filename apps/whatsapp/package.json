{
  "name": "@snapsell/whatsapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,wa -c blue,magenta \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch --enable-source-maps dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@snapsell/shared": "workspace:*",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@snapsell/config": "workspace:*",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.2.1",
    "pino-pretty": "^13.2.0",
    "vitest": "^4.0.0"
  }
}
