{
  "name": "@snapsell/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "reset-owner-password": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/cli/reset-owner-password.js",
    "seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/cli/seed.js"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@node-rs/argon2": "^2.2.2",
    "@snapsell/db": "workspace:*",
    "@snapsell/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "express": "5.3.0",
    "file-type": "^22.3.0",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.37.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@snapsell/config": "workspace:*",
    "@swc/core": "^1.16.21",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.0"
  }
}
